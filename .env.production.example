# Environment Configuration untuk Production

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================
# DATABASE - PostgreSQL
# ============================================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/audio_converter
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# REDIS - Queue & Session Store
# ============================================
# Format: redis://[:password@]host:port[/db-number]
REDIS_URL=redis://:password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-password
REDIS_DB=0

# ============================================
# S3 / OBJECT STORAGE
# ============================================
# Untuk AWS S3
S3_PROVIDER=aws  # atau 'minio' atau 'digitalocean'
S3_BUCKET=audio-converter-files
S3_REGION=us-east-1
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
S3_ENDPOINT=  # Kosongkan untuk AWS, isi untuk MinIO/DO Spaces

# Untuk MinIO (self-hosted)
# S3_PROVIDER=minio
# S3_ENDPOINT=https://minio.yourdomain.com:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Untuk DigitalOcean Spaces
# S3_PROVIDER=digitalocean
# S3_REGION=sgp1
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# ============================================
# FILE STORAGE - Local Directories
# ============================================
UPLOADS_DIR=/data/uploads
OUTPUTS_DIR=/data/outputs
TEMP_DIR=/data/temp
MAX_UPLOAD_SIZE_MB=500
MAX_FILE_DURATION_SECONDS=3600

# ============================================
# DISCORD OAUTH
# ============================================
DISCORD_CLIENT_ID=123456789...
DISCORD_CLIENT_SECRET=...
DISCORD_CALLBACK_URL=https://yourdomain.com/auth/discord/callback

# ============================================
# SESSION & SECURITY
# ============================================
SESSION_SECRET=use-a-very-long-random-string-here-minimum-32-characters
SESSION_TIMEOUT_HOURS=168
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ============================================
# API RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=30   # 30 requests per 15 min

# ============================================
# FFmpeg CONFIGURATION
# ============================================
# Linux
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Windows (uncomment untuk Windows)
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# FFPROBE_PATH=C:\\ffmpeg\\bin\\ffprobe.exe

# ============================================
# WORKER CONFIGURATION
# ============================================
NUM_WORKERS=4
MAX_JOBS_PER_WORKER=1  # FFmpeg intensive, jadi 1 job per worker
JOB_TIMEOUT_MS=600000  # 10 minutes

# ============================================
# CLEANUP & MAINTENANCE
# ============================================
CLEANUP_INTERVAL_HOURS=24
TEMP_FILE_TTL_HOURS=48
ORPHANED_UPLOAD_TTL_HOURS=6
AUTO_DELETE_COMPLETED_JOBS_DAYS=7

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
SENTRY_DSN=https://key@sentry.io/123456
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# CLOUDFLARE / CDN (Optional)
# ============================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CDN_URL=https://cdn.yourdomain.com

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://backup-bucket/audio-converter

# ============================================
# EMAIL NOTIFICATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_YOUTUBE_DOWNLOAD=true
ENABLE_SOUNDCLOUD_DOWNLOAD=false
ENABLE_SPEED_ADJUSTMENT=true
ENABLE_AMPLIFY=true
ENABLE_MAX_DURATION=true
ENABLE_AUTO_SPLIT=true
ENABLE_USER_STATS=true

# ============================================
# TIER/PLAN CONFIGURATION
# ============================================
FREE_TIER_DAILY_LIMIT=5
FREE_TIER_MAX_DURATION_SECONDS=600
PRO_TIER_DAILY_LIMIT=100
PRO_TIER_MAX_DURATION_SECONDS=3600

# ============================================
# CORS & API
# ============================================
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
SOCKET_IO_CORS_ORIGIN=https://yourdomain.com

# ============================================
# DEBUG MODE (PRODUCTION SHOULD BE FALSE)
# ============================================
DEBUG=false
DEBUG_QUEUE=false
DEBUG_FFmpeg=false
