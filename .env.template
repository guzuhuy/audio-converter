# ==============================================================================
# TEMPLATE FILE .env - Copy ke .env dan isi dengan data Anda
# ==============================================================================
# PENTING: File ini hanya CONTOH! Jangan gunakan nilai-nilai ini di production!
#
# Untuk setup:
# 1. Copy .env.example menjadi .env
# 2. Buka .env
# 3. Isi semua field yang kosong dengan data Anda
# 4. Save
# 5. Restart server (npm start)
#
# JANGAN:
# - Commit file .env ke git
# - Bagikan file .env ke orang lain
# - Gunakan test values di production
# ==============================================================================

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
SESSION_SECRET=your-super-secret-key-change-in-production

# ============================================
# DIRECTORY PATHS
# ============================================
UPLOADS_DIR=server/uploads
OUTPUTS_DIR=server/outputs
TEMP_DIR=server/temp
TEMP_TTL_MINUTES=30

# ============================================
# AUDIO PROCESSING (FFmpeg)
# ============================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ============================================
# DATABASE / CACHE
# ============================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# DISCORD CONFIGURATION - PERLU DIISI! ⚠️
# ==============================================================================

# OAuth2 Credentials dari Discord Developer Portal
# Dapat dari: https://discord.com/developers/applications → Aplikasi Anda → General
DISCORD_CLIENT_ID=YOUR_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Bot Token dari Discord Developer Portal
# Dapat dari: https://discord.com/developers/applications → Aplikasi Anda → Bot → Copy Token
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Redirect URL untuk OAuth callback (jangan ubah untuk localhost)
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Guild ID (Server ID) - Untuk membership check
# Dapatkan dengan: Discord → Enable Developer Mode → Klik kanan Server → Copy Server ID
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE

# Invite URL - Link untuk non-members bergabung
# Format: https://discord.gg/CODE
# Dapat dari: Discord → Server → Create Invite → Copy Link
DISCORD_INVITE_URL=https://discord.gg/YOUR_INVITE_CODE_HERE

# Admin Discord ID (Opsional - untuk admin-only features)
# Dapatkan dengan: Discord → Enable Developer Mode → Klik kanan User → Copy User ID
ADMIN_DISCORD_ID=YOUR_ADMIN_ID_HERE
