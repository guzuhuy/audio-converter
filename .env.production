# ============================================
# PRODUCTION CONFIGURATION untuk pakhuang.store
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================
# DOMAIN & URL
# ============================================
DOMAIN=pakhuang.store
PROTOCOL=https

# ============================================
# DISCORD OAUTH (SUDAH ADA)
# ============================================
DISCORD_CLIENT_ID=1513274735784493196
DISCORD_CLIENT_SECRET=ywx56gr5L8Yy07NNwN3oY7CpcpIrR70v
DISCORD_CALLBACK_URL=https://pakhuang.store/auth/discord/callback
DISCORD_GUILD_ID=1443112059213713440
DISCORD_INVITE_URL=https://discord.gg/mMPMyPGq6W

# Admin Discord ID untuk special privileges
ADMIN_DISCORD_ID=1389687197447225495

# ============================================
# DATABASE - PostgreSQL (Railway)
# ============================================
# Format: postgresql://user:password@host:port/database
# Ambil dari Railway PostgreSQL Service
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# REDIS - Queue & Session Store (Railway)
# ============================================
# Format: redis://[:password@]host:port
# Ambil dari Railway Redis Service
REDIS_URL=redis://:password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ============================================
# FILE STORAGE
# ============================================
UPLOADS_DIR=/data/uploads
OUTPUTS_DIR=/data/outputs
TEMP_DIR=/data/temp
MAX_UPLOAD_SIZE_MB=500
MAX_FILE_DURATION_SECONDS=3600
TEMP_TTL_MINUTES=30

# ============================================
# SESSION & SECURITY
# ============================================
# Generate strong random string (min 32 chars)
# Gunakan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-very-long-random-string-here-minimum-32-characters
SESSION_TIMEOUT_HOURS=168
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ============================================
# FFmpeg PATHS
# ============================================
# Linux/Railway default
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ============================================
# WORKER CONFIGURATION
# ============================================
NUM_WORKERS=4
MAX_JOBS_PER_WORKER=1
JOB_TIMEOUT_MS=600000

# ============================================
# CLEANUP & MAINTENANCE
# ============================================
CLEANUP_INTERVAL_HOURS=24
TEMP_FILE_TTL_HOURS=48
ORPHANED_UPLOAD_TTL_HOURS=6
AUTO_DELETE_COMPLETED_JOBS_DAYS=7

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info
# Sentry (error tracking) - optional
# SENTRY_DSN=https://key@sentry.io/123456

# ============================================
# API RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

# ============================================
# CORS & API
# ============================================
CORS_ORIGIN=https://pakhuang.store,https://www.pakhuang.store
API_BASE_URL=https://pakhuang.store
SOCKET_IO_CORS_ORIGIN=https://pakhuang.store

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_YOUTUBE_DOWNLOAD=true
ENABLE_SOUNDCLOUD_DOWNLOAD=false
ENABLE_SPEED_ADJUSTMENT=true
ENABLE_AMPLIFY=true
ENABLE_MAX_DURATION=true
ENABLE_AUTO_SPLIT=true
ENABLE_USER_STATS=true

# ============================================
# TIER/PLAN CONFIGURATION
# ============================================
FREE_TIER_DAILY_LIMIT=5
FREE_TIER_MAX_DURATION_SECONDS=600
PRO_TIER_DAILY_LIMIT=100
PRO_TIER_MAX_DURATION_SECONDS=3600

# ============================================
# OPTIONAL: S3 STORAGE (untuk upgrade nanti)
# ============================================
# S3_PROVIDER=aws
# S3_BUCKET=audio-converter-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ============================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ADMIN_EMAIL=

# ============================================
# DEBUG (PRODUCTION SHOULD BE FALSE)
# ============================================
DEBUG=false
