# Example environment variables
# Set to true to bypass Discord authentication (offline/localhost mode)
BYPASS_AUTH=true
PORT=3000
NODE_ENV=development
TEMP_TTL_MINUTES=30
REDIS_URL=redis://localhost:6379
UPLOADS_DIR=server/uploads
OUTPUTS_DIR=server/outputs
TEMP_DIR=server/temp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SESSION_SECRET=change-this-secret

# -----------------------------
# Discord / OAuth settings
# -----------------------------
# Discord OAuth application credentials (set these from Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Optional: guild membership check
# Set this to your Discord server (guild) ID to require users to be members.
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=https://discord.gg/mMPMyPGq6W

# Optional bot token used to query the Guild Member endpoint as a fallback
# (only required if you prefer server-side membership checks and/or the user
# does not grant the `guilds` OAuth scope).
DISCORD_BOT_TOKEN=

# Admin user (optional)
ADMIN_DISCORD_ID=
